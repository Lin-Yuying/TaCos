[Unit]
Description=TaCos team server
After=network.target

[Service]
User=tacos
Group=tacos
WorkingDirectory=/opt/tacos/app
EnvironmentFile=/etc/tacos/env
ExecStart=/opt/tacos/node/bin/node /opt/tacos/app/server.js
Restart=on-failure
RestartSec=3
# The box also runs other services and has 1.9 GiB of memory.
MemoryMax=900M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tacos

[Install]
WantedBy=multi-user.target
