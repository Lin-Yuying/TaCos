{
  "name": "tacos",
  "productName": "TaCos",
  "version": "2.2.2",
  "private": true,
  "description": "TaCos — self-hosted issue tracker for teams and their agents",
  "license": "MIT",
  "author": "Yuying Lin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lin-Yuying/tacos.git"
  },
  "homepage": "https://github.com/Lin-Yuying/tacos",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "server:bundle": "node scripts/bundle-server.mjs",
    "start": "next start",
    "lint": "eslint",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --mac --config electron/builder.base.json",
    "desktop:dist:win": "electron-builder --win --x64 --config electron/builder.base.json",
    "desktop:standalone:mac": "npm run build && npm run server:bundle && electron-builder --mac --publish never --config electron/builder.standalone.json",
    "desktop:standalone:win": "npm run build && npm run server:bundle -- --target=win32-x64 && electron-builder --win --x64 --publish never --config electron/builder.standalone.json",
    "mcp": "tsx mcp/server.ts",
    "mcp:test": "tsx scripts/test-mcp.ts",
    "check:harness": "tsx scripts/check-all.ts",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@floating-ui/dom": "^1.8.0",
    "@fullcalendar/react": "^7.1.4",
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-collaboration": "^3.32.2",
    "@tiptap/extension-collaboration-caret": "^3.32.2",
    "@tiptap/extension-color": "^3.32.2",
    "@tiptap/extension-details": "^3.32.2",
    "@tiptap/extension-drag-handle": "^3.32.2",
    "@tiptap/extension-drag-handle-react": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-node-range": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@tiptap/y-tiptap": "^3.0.12",
    "@tus/file-store": "^2.1.2",
    "@tus/server": "^2.4.7",
    "@uppy/core": "^6.3.1",
    "@uppy/tus": "^6.0.1",
    "better-sqlite3": "^13.0.3",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "^1.0.7",
    "undici": "^7.30.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "js-yaml": "^4.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "ws": "^8.22.1"
  },
  "build": {
    "extends": "./electron/builder.base.json"
  }
}
