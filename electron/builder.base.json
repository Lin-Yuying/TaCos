{
  "appId": "app.tacos.desktop",
  "productName": "TaCos",
  "files": ["electron/**/*", "package.json", "!node_modules/**"],
  "extraResources": [
    {
      "from": "docs/markdown-guide.html",
      "to": "docs/markdown-guide.html"
    }
  ],
  "npmRebuild": false,
  "afterPack": "./electron/after-pack.js",
  "fileAssociations": [
    {
      "ext": ["md", "markdown", "mdx", "txt"],
      "name": "Markdown Document",
      "description": "Markdown document",
      "mimeType": "text/markdown",
      "role": "Editor",
      "rank": "Alternate"
    }
  ],
  "directories": {
    "output": "release",
    "buildResources": "electron/assets"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "electron/assets/icon.icns",
    "target": [{ "target": "dmg", "arch": ["arm64"] }]
  },
  "dmg": {
    "title": "TaCos",
    "window": { "width": 560, "height": 320 },
    "contents": [
      { "x": 140, "y": 150 },
      { "x": 420, "y": 150, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "icon": "electron/assets/icon.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName}-Setup-${version}.${ext}"
  }
}
