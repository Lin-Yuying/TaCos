{
  "extends": "./electron/builder.base.json",
  "directories": {
    "output": "release-standalone",
    "buildResources": "electron/assets"
  },
  "extraResources": [
    {
      "from": "dist/server",
      "to": "server",
      "filter": [
        "**/*"
      ]
    }
  ],
  "linux": {
    "target": "AppImage",
    "category": "Development",
    "artifactName": "${productName}-Local-${version}-${arch}.${ext}"
  },
  "dmg": {
    "title": "TaCos (Local)",
    "artifactName": "${productName}-Local-${version}-${arch}.${ext}"
  },
  "nsis": {
    "artifactName": "${productName}-Local-Setup-${version}.${ext}"
  }
}
